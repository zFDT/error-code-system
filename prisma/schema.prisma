datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  projectCode String   @unique // 项目编号，唯一，如001
  modules     Module[]
}

model Module {
  id          Int      @id @default(autoincrement())
  name        String
  moduleCode  String
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id])
  errors      Error[]
  @@unique([projectId, moduleCode]) // 同一项目下模块编号唯一
}

model Error {
  id          Int     @id @default(autoincrement())
  name        String  // 错误名称
  description String  // 错误描述
  errorCode   String  // 错误编号，如001
  moduleId    Int
  module      Module  @relation(fields: [moduleId], references: [id])
  @@unique([moduleId, errorCode]) // 同一模块下错误编号唯一
}